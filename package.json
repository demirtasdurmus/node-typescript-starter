{
  "name": "node-typescript-starter",
  "version": "1.0.0",
  "description": "Node Typescript Starter Boilerplate",
  "packageManager": "pnpm@11.28.6",
  "keywords": [
    "node",
    "typescript",
    "starter",
    "boilerplate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --enable-source-maps dist/index.mjs\"",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.mjs",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix . --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "clean": "bash scripts/clean.sh",
    "commit": "commit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
