{
  "name": "node-typescript-starter",
  "version": "1.0.0",
  "description": "Node Typescript Starter Boilerplate",
  "keywords": [
    "node",
    "typescript",
    "starter",
    "boilerplate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev:tsc": "tsc --watch --preserveWatchOutput -p tsconfig.build.json",
    "dev:node": "node --enable-source-maps --watch dist/index.js",
    "dev": "pnpm run \"/dev:/\"",
    "build": "tsc --pretty -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint --fix .",
    "format:write": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "clean": "bash scripts/clean.sh",
    "commit": "commit",
    "prepare": "husky",
    "postinstall": "pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/prompt-cli": "^20.5.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.8.3",
    "prettier-plugin-sort-imports": "^1.8.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsc-files": "^1.1.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
