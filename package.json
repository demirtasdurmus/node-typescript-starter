{
  "name": "node-typescript-starter",
  "version": "1.0.0",
  "description": "Node Typescript Starter Boilerplate",
  "packageManager": "pnpm@11.2.2",
  "keywords": [
    "node",
    "typescript",
    "starter",
    "boilerplate"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --watch --enable-source-maps --tsconfig tsconfig.build.json src/index.ts",
    "dev:bundle": "tsdown --watch --on-success \"node --enable-source-maps dist-bundle/index.mjs\"",
    "build": "tsc --pretty -p tsconfig.build.json",
    "build:bundle": "tsdown",
    "start": "node --enable-source-maps dist/index.js",
    "start:bundle": "node --enable-source-maps dist-bundle/index.mjs",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --fix . --cache",
    "lint:check": "eslint . --cache",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,mts,cts,json,yml,yaml,md}\" --cache",
    "clean": "bash scripts/clean.sh",
    "commit": "commit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/prompt-cli": "^21.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.4",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.5",
    "npm-check-updates": "^22.2.1",
    "prettier": "^3.8.3",
    "prettier-plugin-sort-imports": "^1.8.11",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.22.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
